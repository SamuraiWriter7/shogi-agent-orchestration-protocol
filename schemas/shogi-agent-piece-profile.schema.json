{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shidenkai-alpha.github.io/shogi-agent-orchestration-protocol/schemas/shogi-agent-piece-profile.schema.json",
  "title": "Shogi Agent Piece Profile",
  "description": "Defines a role-bounded AI agent as a shogi-inspired piece with explicit capabilities, authority, movement limits, resource budgets, and optional promotion constraints.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "piece_profile_id",
    "agent_id",
    "piece_type",
    "side",
    "role_name",
    "lifecycle_state",
    "capability_profile",
    "authority_scope",
    "movement_profile",
    "resource_budget",
    "human_axis_binding_ref",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.5.0"
    },
    "piece_profile_id": {
      "$ref": "#/$defs/identifier"
    },
    "agent_id": {
      "$ref": "#/$defs/identifier"
    },
    "piece_type": {
      "enum": [
        "king",
        "rook",
        "bishop",
        "gold",
        "silver",
        "knight",
        "lance",
        "pawn",
        "custom"
      ]
    },
    "side": {
      "enum": [
        "sente",
        "gote",
        "neutral"
      ]
    },
    "role_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "role_description": {
      "type": "string",
      "maxLength": 1000
    },
    "lifecycle_state": {
      "enum": [
        "reserve",
        "active",
        "suspended",
        "retired"
      ]
    },
    "capability_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_actions",
        "denied_actions",
        "tools",
        "data_scopes"
      ],
      "properties": {
        "allowed_actions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "denied_actions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "tools": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "data_scopes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        }
      }
    },
    "authority_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_scope_ref",
        "max_autonomy",
        "requires_human_review_for"
      ],
      "properties": {
        "authority_scope_ref": {
          "$ref": "#/$defs/identifier"
        },
        "max_autonomy": {
          "enum": [
            "advisory",
            "supervised",
            "delegated"
          ]
        },
        "requires_human_review_for": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        }
      }
    },
    "movement_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "movement_policy_ref",
        "max_hops_per_move",
        "may_cross_security_zones",
        "may_enter_restricted_zones"
      ],
      "properties": {
        "movement_policy_ref": {
          "$ref": "#/$defs/identifier"
        },
        "max_hops_per_move": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32
        },
        "may_cross_security_zones": {
          "type": "boolean"
        },
        "may_enter_restricted_zones": {
          "type": "boolean"
        }
      }
    },
    "resource_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_tokens_per_move",
        "max_cost_per_move",
        "currency",
        "max_duration_seconds",
        "max_concurrent_actions"
      ],
      "properties": {
        "max_tokens_per_move": {
          "type": "integer",
          "minimum": 0
        },
        "max_cost_per_move": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "max_duration_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "max_concurrent_actions": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "human_axis_binding_ref": {
      "$ref": "#/$defs/identifier"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "integer",
          "boolean",
          "null"
        ]
      }
    },
    "promotion_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_promoted_piece_types",
        "allowed_zone_types",
        "allowed_capability_additions",
        "allowed_tool_additions",
        "allowed_data_scope_additions",
        "allowed_authority_scope_refs",
        "max_duration_seconds",
        "max_resource_multiplier",
        "requires_human_review"
      ],
      "properties": {
        "allowed_promoted_piece_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/promoted_piece_type"
          }
        },
        "allowed_zone_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/zone_type"
          }
        },
        "allowed_capability_additions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "allowed_tool_additions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "allowed_data_scope_additions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "allowed_authority_scope_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "max_duration_seconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 86400
        },
        "max_resource_multiplier": {
          "type": "number",
          "minimum": 1,
          "maximum": 10
        },
        "requires_human_review": {
          "type": "boolean"
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{2,127}$"
    },
    "promoted_piece_type": {
      "enum": [
        "promoted-rook",
        "promoted-bishop",
        "promoted-silver",
        "promoted-knight",
        "promoted-lance",
        "promoted-pawn",
        "custom-promoted"
      ]
    },
    "zone_type": {
      "enum": [
        "human-control",
        "planning",
        "research",
        "execution",
        "audit",
        "settlement",
        "reserve",
        "quarantine",
        "custom"
      ]
    }
  }
}
