{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shidenkai-alpha.github.io/shogi-agent-orchestration-protocol/schemas/legal-move-evaluation.schema.json",
  "title": "Legal Move Evaluation",
  "description": "Records a reproducible legality decision for a proposed agent move against a specific board revision and policy.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "move_evaluation_id",
    "move_proposal_ref",
    "mission_id",
    "board_state_ref",
    "evaluated_board_revision",
    "piece_profile_id",
    "agent_id",
    "source_node_id",
    "target_node_id",
    "legal_move_policy_ref",
    "decision",
    "checks",
    "required_controls",
    "evaluation_reasons",
    "evaluated_by",
    "evaluated_at",
    "valid_until",
    "trace_ref"
  ],
  "properties": {
    "schema_version": {
      "const": "0.5.0"
    },
    "move_evaluation_id": {
      "$ref": "#/$defs/identifier"
    },
    "move_proposal_ref": {
      "$ref": "#/$defs/identifier"
    },
    "mission_id": {
      "$ref": "#/$defs/identifier"
    },
    "board_state_ref": {
      "$ref": "#/$defs/identifier"
    },
    "evaluated_board_revision": {
      "type": "integer",
      "minimum": 1
    },
    "piece_profile_id": {
      "$ref": "#/$defs/identifier"
    },
    "agent_id": {
      "$ref": "#/$defs/identifier"
    },
    "source_node_id": {
      "$ref": "#/$defs/identifier"
    },
    "target_node_id": {
      "$ref": "#/$defs/identifier"
    },
    "legal_move_policy_ref": {
      "$ref": "#/$defs/identifier"
    },
    "decision": {
      "enum": [
        "allow",
        "human-review",
        "deny"
      ]
    },
    "matched_rule_id": {
      "$ref": "#/$defs/identifier"
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path_node_ids",
        "hop_count"
      ],
      "properties": {
        "path_node_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "hop_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32
        }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mission_in_scope",
        "board_reference_current",
        "piece_registered",
        "agent_matches_piece",
        "source_matches_board",
        "target_available",
        "target_zone_allows_piece",
        "route_reachable",
        "within_piece_hop_limit",
        "movement_rule_matched",
        "required_capabilities_present",
        "security_boundary_allowed",
        "restricted_zone_entry_allowed",
        "resource_budget_satisfied",
        "all_checks_passed"
      ],
      "properties": {
        "mission_in_scope": {
          "type": "boolean"
        },
        "board_reference_current": {
          "type": "boolean"
        },
        "piece_registered": {
          "type": "boolean"
        },
        "agent_matches_piece": {
          "type": "boolean"
        },
        "source_matches_board": {
          "type": "boolean"
        },
        "target_available": {
          "type": "boolean"
        },
        "target_zone_allows_piece": {
          "type": "boolean"
        },
        "route_reachable": {
          "type": "boolean"
        },
        "within_piece_hop_limit": {
          "type": "boolean"
        },
        "movement_rule_matched": {
          "type": "boolean"
        },
        "required_capabilities_present": {
          "type": "boolean"
        },
        "security_boundary_allowed": {
          "type": "boolean"
        },
        "restricted_zone_entry_allowed": {
          "type": "boolean"
        },
        "resource_budget_satisfied": {
          "type": "boolean"
        },
        "all_checks_passed": {
          "type": "boolean"
        }
      }
    },
    "required_controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorization_required",
        "human_review_required"
      ],
      "properties": {
        "authorization_required": {
          "type": "boolean"
        },
        "human_review_required": {
          "type": "boolean"
        }
      }
    },
    "evaluation_reasons": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    },
    "evaluated_by": {
      "$ref": "#/$defs/identifier"
    },
    "evaluated_at": {
      "type": "string",
      "format": "date-time"
    },
    "valid_until": {
      "type": "string",
      "format": "date-time"
    },
    "trace_ref": {
      "$ref": "#/$defs/identifier"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "enum": [
              "allow",
              "human-review"
            ]
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "required": [
          "matched_rule_id",
          "route"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "const": "deny"
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "properties": {
          "evaluation_reasons": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "const": "human-review"
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "properties": {
          "required_controls": {
            "properties": {
              "human_review_required": {
                "const": true
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{2,127}$"
    }
  }
}

