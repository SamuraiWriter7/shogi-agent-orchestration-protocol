{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shidenkai-alpha.github.io/shogi-agent-orchestration-protocol/schemas/legal-move-policy.schema.json",
  "title": "Legal Move Policy",
  "description": "Defines legal initial placements and zone-to-zone moves, including control requirements, for shogi-inspired agent pieces.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "policy_version",
    "allowed_mission_ids",
    "default_decision",
    "initial_placement_rules",
    "movement_rules",
    "created_by",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.3.0"
    },
    "policy_id": {
      "$ref": "#/$defs/identifier"
    },
    "policy_version": {
      "type": "string",
      "pattern": "^0\\.3\\.[0-9]+$"
    },
    "allowed_mission_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "default_decision": {
      "enum": [
        "deny",
        "human-review"
      ]
    },
    "initial_placement_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/initial_rule"
      }
    },
    "movement_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/movement_rule"
      }
    },
    "created_by": {
      "$ref": "#/$defs/identifier"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{2,127}$"
    },
    "piece_type": {
      "enum": [
        "king",
        "rook",
        "bishop",
        "gold",
        "silver",
        "knight",
        "lance",
        "pawn",
        "custom"
      ]
    },
    "zone_type": {
      "enum": [
        "human-control",
        "planning",
        "research",
        "execution",
        "audit",
        "settlement",
        "reserve",
        "quarantine",
        "custom"
      ]
    },
    "initial_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "piece_types",
        "allowed_zone_types",
        "requires_authorization",
        "requires_human_review"
      ],
      "properties": {
        "rule_id": {
          "$ref": "#/$defs/identifier"
        },
        "piece_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/piece_type"
          }
        },
        "allowed_zone_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/zone_type"
          }
        },
        "required_capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "requires_authorization": {
          "type": "boolean"
        },
        "requires_human_review": {
          "type": "boolean"
        }
      }
    },
    "movement_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "piece_types",
        "from_zone_types",
        "to_zone_types",
        "max_hops",
        "required_capabilities",
        "requires_authorization",
        "requires_human_review"
      ],
      "properties": {
        "rule_id": {
          "$ref": "#/$defs/identifier"
        },
        "piece_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/piece_type"
          }
        },
        "from_zone_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/zone_type"
          }
        },
        "to_zone_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/zone_type"
          }
        },
        "max_hops": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32
        },
        "required_capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "requires_authorization": {
          "type": "boolean"
        },
        "requires_human_review": {
          "type": "boolean"
        }
      }
    }
  }
}

